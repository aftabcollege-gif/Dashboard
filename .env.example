# Enterprise Intelligence BI Platform — Production Environment Template
# Copy to .env and replace ALL placeholder secrets before starting production containers.
# Generate high-entropy secrets via:
#   openssl rand -hex 32
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

ENVIRONMENT=production
BI_SEED_DEMO_USERS=false
BI_REQUIRE_GENERATED_SECRETS=true
BI_AUTO_CREATE_SCHEMA=false

# PostgreSQL (required in production)
POSTGRES_USER=bi_admin
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RANDOM_POSTGRES_PASSWORD
POSTGRES_DB=bi_platform
DATABASE_URL=postgresql+psycopg2://bi_admin:REPLACE_WITH_STRONG_RANDOM_POSTGRES_PASSWORD@postgres:5432/bi_platform

# DuckDB Analytical Warehouse
WAREHOUSE_DUCKDB_PATH=/app/data/warehouse.duckdb

# Redis Cache, Rate Limiting & Scheduler Leader Election
REDIS_PASSWORD=REPLACE_WITH_STRONG_RANDOM_REDIS_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_STRONG_RANDOM_REDIS_PASSWORD@redis:6379/0
CACHE_TTL_SEC=300
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_CLOSED_PROD=true

# Cryptographic Keys (MUST be set uniquely per deployment)
BI_JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_JWT_SECRET
BI_CRED_KEY=REPLACE_WITH_32_BYTE_FERNET_BASE64_KEY
BI_INITIAL_SETUP_TOKEN=REPLACE_WITH_ONE_TIME_INITIAL_SETUP_TOKEN
BI_REQUIRE_ADMIN_MFA_IN_PROD=true

# Origins, Cookies & Reverse Proxy
BI_CORS_ORIGINS=https://bi.example.com
BI_COOKIE_SECURE=true
BI_COOKIE_SAMESITE=lax
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_IPS=127.0.0.1,::1

# Background Scheduler & Query Timeouts
BI_ENABLE_SCHEDULER=true
ETL_RUN_TIMEOUT_SECONDS=120
ETL_STALE_RUN_TIMEOUT_MINUTES=30
QUERY_TIMEOUT_SECONDS=15.0
EXTERNAL_QUERY_TIMEOUT_SECONDS=15

# Active Directory / LDAPS (strict TLS verification)
AD_MODE=ldaps
AD_ENABLED=false
AD_HOST=dc01.corp.enterprise.local
AD_PORT=636
AD_USE_SSL=true
AD_DOMAIN=corp.enterprise.local
AD_BASE_DN=DC=corp,DC=enterprise,DC=local
LDAP_TLS_CA_CERT_FILE=

# Frontend -> Backend Internal Proxy URL
BACKEND_INTERNAL_URL=http://backend:8000
