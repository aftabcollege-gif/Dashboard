# Enterprise Intelligence BI Platform Configuration
# Layer 1: Application Metadata Database (PostgreSQL recommended in prod; SQLite local fallback)
DATABASE_URL=postgresql+psycopg2://bi_admin:ChangeMeStrongPass2026@postgres:5432/bi_platform

# Layer 2: Analytical Data Warehouse (DuckDB Columnar OLAP)
WAREHOUSE_DUCKDB_PATH=/app/data/warehouse.duckdb

# Layer 3: High-Speed Cache & Materialized Query Results (Redis + In-Memory/Disk fallback)
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SEC=300

# Security & Credential Encryption (Generate unique 32-byte Fernet key for production)
SECRET_KEY=replace-with-high-entropy-64-char-secret-key
CREDENTIAL_ENCRYPTION_KEY=

# Active Directory / LDAP Integration
AD_MODE=ldaps
AD_ENABLED=true
AD_HOST=dc01.corp.enterprise.local
AD_PORT=636
AD_USE_SSL=true
AD_DOMAIN=corp.enterprise.local
AD_BASE_DN=DC=corp,DC=enterprise,DC=local

# Frontend -> Backend Proxy Target
BACKEND_INTERNAL_URL=http://backend:8000
